{
  "manifest_version": 2,
  "name": "Excela — Quick Inject",
  "version": "0.3.0",
  "description": "Send announcements to your connected Excela planner from a compact popup.",
  "browser_specific_settings": {
    "gecko": { "id": "excela-local@excela.app", "strict_min_version": "121.0" }
  },
  "permissions": ["cookies", "storage", "https://excela.cfat.site/*", "https://localhost/*"],
  "background": { "scripts": ["background.js"], "persistent": true },
  "browser_action": { "default_title": "Excela", "default_popup": "popup.html", "default_icon": "logo.png" },
  "icons": { "48": "logo.png", "96": "logo.png" }
}
