{
  "manifest_version": 3,
  "name": "Excela",
  "version": "0.4.0",
  "description": "Chat with your Excela planner agent from a compact popup.",
  "permissions": ["cookies", "storage", "activeTab"],
  "host_permissions": ["https://excela.cfat.site/*", "https://localhost/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Excela", "default_popup": "popup.html", "default_icon": { "48": "logo.png" } },
  "icons": { "48": "logo.png", "96": "logo.png" }
}
