OLLAMA_API=
GEMINI_API=
# MongoDB Atlas connection string. The database name in the path (/Excela) is where
# Excela stores users, sessions and each user's saved planner link.
MONGODB_URI=mongodb://USER:PASSWORD@HOST1:27017,HOST2:27017,HOST3:27017/Excela?ssl=true&replicaSet=REPLICA_SET&authSource=admin
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Saved for future integrations; sign-in and Sheets sync use OAuth, not this key.
GOOGLE_API_KEY=
GOOGLE_REDIRECT_URI=https://localhost:3000/api/google/callback
# A random secret used to encrypt Google refresh tokens stored in MongoDB. Keep server-side and stable.
GOOGLE_SESSION_SECRET=
